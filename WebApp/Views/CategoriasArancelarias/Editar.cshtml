@model Capa_de_Negocio.ViewModels.CategoriaArancelariaViewModel

@{
    ViewData["Title"] = "Editar Categoría Arancelaria";
}

<div class="container py-4 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
            </div>

            @if (Model.TieneProductosAsociados)
            {
                <div class="alert alert-warning border-0 shadow-sm small mb-3" role="alert">
                    <i class="bi bi-lock-fill me-2"></i>
                    <strong>Campos protegidos:</strong> Esta categoría está asociada a productos registrados. Solo puede modificar el nombre o descripción y el estado para proteger el histórico de cálculos.
                </div>
            }

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 border-bottom bg-light rounded-top-3">
                    <h2 class="h4 mb-1 text-dark fw-bold">
                        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Categoría Arancelaria
                    </h2>
                    <p class="text-muted small mb-0">Modifique los parámetros de la clasificación aduanal seleccionada.</p>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="TieneProductosAsociados" />

                        @if (Model.TieneProductosAsociados)
                        {
                            <input type="hidden" asp-for="Codigo" />
                            <input type="hidden" asp-for="PorcentajeArancel" />
                            <input type="hidden" asp-for="AplicaItbis" />
                            <input type="hidden" asp-for="AplicaSelectivo" />
                            <input type="hidden" asp-for="PorcentajeSelectivo" />
                        }

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small shadow-sm d-none" id="validationSummary"></div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Codigo" class="form-label fw-semibold text-secondary small">Código Arancelario</label>
                                <input asp-for="Codigo" class="form-control font-monospace fw-bold bg-light" 
                                       readonly="@Model.TieneProductosAsociados" placeholder="Ej. 8471.30" />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8 mb-3">
                                <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small">Nombre o Descripción</label>
                                <input asp-for="Descripcion" class="form-control" placeholder="Ej. Computadoras portátiles" />
                                <span asp-validation-for="Descripcion" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row align-items-center mb-4">
                            <div class="col-md-4 mb-3">
                                <label asp-for="PorcentajeArancel" class="form-label fw-semibold text-secondary small">Porcentaje de Arancel (%)</label>
                                <div class="input-group">
                                    <input asp-for="PorcentajeArancel" type="number" step="0.01" class="form-control font-monospace @(Model.TieneProductosAsociados ? "bg-light" : "")" 
                                           readonly="@Model.TieneProductosAsociados" placeholder="0.00" min="0" max="100" />
                                    <span class="input-group-text bg-light text-muted">%</span>
                                </div>
                                <span asp-validation-for="PorcentajeArancel" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3 ps-md-4">
                                <div class="form-check form-switch pt-3">
                                    <input asp-for="AplicaItbis" type="checkbox" class="form-check-input" role="switch" 
                                           disabled="@Model.TieneProductosAsociados" />
                                    <label asp-for="AplicaItbis" class="form-check-label fw-semibold text-dark small">Aplica ITBIS</label>
                                </div>
                            </div>

                            <div class="col-md-4 mb-3 ps-md-4">
                                <div class="form-check form-switch pt-3">
                                    <input asp-for="Estado" type="checkbox" class="form-check-input" role="switch" />
                                    <label asp-for="Estado" class="form-check-label fw-semibold text-dark small">Categoría Activa</label>
                                </div>
                            </div>
                        </div>

                        <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                            <div class="row align-items-center">
                                <div class="col-md-5 mb-2 mb-md-0">
                                    <div class="form-check form-switch">
                                        <input asp-for="AplicaSelectivo" type="checkbox" class="form-check-input" role="switch" id="chkSelectivo" 
                                               disabled="@Model.TieneProductosAsociados" />
                                        <label asp-for="AplicaSelectivo" class="form-check-label fw-semibold text-dark small">Aplica Impuesto Selectivo</label>
                                    </div>
                                </div>

                                <div class="col-md-7">
                                    <div class="d-flex align-items-center">
                                        <label asp-for="PorcentajeSelectivo" class="form-label fw-semibold text-secondary small me-3 mb-0 text-nowrap">Porcentaje Selectivo (%)</label>
                                        <div class="input-group">
                                            <input asp-for="PorcentajeSelectivo" type="number" step="0.01" class="form-control font-monospace" placeholder="0.00" min="0" max="100" id="txtPorcentajeSelectivo" 
                                                   readonly="@Model.TieneProductosAsociados" />
                                            <span class="input-group-text bg-white text-muted">%</span>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span asp-validation-for="PorcentajeSelectivo" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-end pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light fw-semibold me-2 px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chkSelectivo = document.getElementById("chkSelectivo");
            const txtPorcentajeSelectivo = document.getElementById("txtPorcentajeSelectivo");
            const validationSummary = document.getElementById("validationSummary");
            const tieneProductos = @Model.TieneProductosAsociados.ToString().ToLower();

            if (validationSummary && validationSummary.innerHTML.trim() !== "") {
                validationSummary.classList.remove("d-none");
            }

            function evaluarImpuestoSelectivo() {
                // Si la categoría ya tiene productos, el JS no debe alterar los estados de bloqueo nativos
                if (tieneProductos) {
                    txtPorcentajeSelectivo.classList.add("bg-light");
                    return;
                }

                if (chkSelectivo.checked) {
                    txtPorcentajeSelectivo.disabled = false;
                    txtPorcentajeSelectivo.classList.remove("bg-light");
                    if (txtPorcentajeSelectivo.value == "0" || txtPorcentajeSelectivo.value == "0.00") {
                        txtPorcentajeSelectivo.value = "";
                    }
                } else {
                    txtPorcentajeSelectivo.value = "0";
                    txtPorcentajeSelectivo.disabled = true;
                    txtPorcentajeSelectivo.classList.add("bg-light");
                }
            }

            if (!tieneProductos) {
                chkSelectivo.addEventListener("change", evaluarImpuestoSelectivo);
            }
            
            evaluarImpuestoSelectivo();
        });
    </script>
}
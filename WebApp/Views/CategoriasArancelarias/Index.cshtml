@model IEnumerable<Capa_de_Negocio.ViewModels.CategoriaArancelariaViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Categorías Arancelarias";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Categorías Arancelarias</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Crear categoría arancelaria
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.85rem;">
                    <tr>
                        <th class="p-3">Código Arancelario</th>
                        <th class="p-3">Nombre o Descripción</th>
                        <th class="p-3">Porcentaje Arancel</th>
                        <th class="p-3">Aplica ITBIS</th>
                        <th class="p-3">Aplica Selectivo</th>
                        <th class="p-3">Porcentaje Selectivo</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No hay categorías arancelarias registradas.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 text-dark font-weight-bold font-monospace">@item.Codigo</td>
                                
                                <td class="p-3 text-secondary font-weight-bold">@item.Descripcion</td>
                                
                                <td class="p-3 text-dark font-weight-bold font-monospace">
                                    @item.PorcentajeArancel.ToString("0.##")%
                                </td>
                                
                                <td class="p-3">
                                    @if (item.AplicaItbis)
                                    {
                                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-check-lg me-1"></i>Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">No</span>
                                    }
                                </td>
                                
                                <td class="p-3">
                                    @if (item.AplicaSelectivo)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-lightning-fill me-1"></i>Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">No</span>
                                    }
                                </td>
                                
                                <td class="p-3 font-monospace text-secondary">
                                    @if (item.AplicaSelectivo)
                                    {
                                        <span class="font-weight-bold text-dark">@item.PorcentajeSelectivo.ToString("0.##")%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0%</span>
                                    }
                                </td>
                                
                                <td class="p-3">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                
                                <td class="p-3 text-end">
    <div class="d-flex justify-content-end align-items-center">
        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-2">
            <i class="bi bi-pencil-square me-1"></i>Editar
        </a>
        
        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-trash3 me-1"></i>Eliminar
        </a>
    </div>
</td>
                                  
                                </tr>

                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
@model Capa_de_Negocio.ViewModels.CategoriaArancelariaViewModel

@{
    ViewData["Title"] = "Eliminar Categoría Arancelaria";
}

<div class="container mt-4 animate__animated animate__fadeIn" style="max-width: 550px;">
    <div class="card shadow-sm border-danger p-4 text-center">
        <div class="text-danger mb-3 fs-1">⚠️</div>
        
        <h4 class="text-dark font-weight-bold mb-3">¿Está seguro que desea eliminar esta categoría arancelaria?</h4>
        
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger text-start font-weight-bold mb-3 shadow-sm">
                <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
            </div>
        }

        <div class="bg-light p-3 rounded text-start mb-4 border">
            <p class="mb-1 text-secondary"><strong>Código Arancelario:</strong> <span class="font-monospace fw-bold text-dark">@Model.Codigo</span></p>
            <p class="mb-1 text-secondary"><strong>Descripción:</strong> <span class="text-dark">@Model.Descripcion</span></p>
            <p class="mb-0 text-secondary"><strong>Porcentaje Arancel:</strong> <span class="font-monospace text-dark">@Model.PorcentajeArancel.ToString("0.##")%</span></p>
        </div>

        <form asp-action="Eliminar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="d-flex justify-content-around">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">Aceptar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
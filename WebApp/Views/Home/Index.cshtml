@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 font-weight-bold text-primary">ImportCost Pro</h1>
        <p class="lead text-secondary">Sistema de Gestión de Importaciones y Cálculo de Landed Cost</p>
    </div>

    <!-- Módulos de Operaciones -->
    <h4 class="mb-4 text-secondary font-weight-bold text-uppercase small border-bottom pb-2">Proceso de Importación</h4>
    <div class="row g-4 mb-5">
        <div class="col-md-4 col-lg-3">
            <a asp-controller="OrdenImportacion" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-blue">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-file-invoice fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Mantenimiento de Órdenes</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="OrdenImportacion" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-cyan">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-list-ul fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Detalle de Productos</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="GastosImportacion" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-orange">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-hand-holding-usd fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Registro de Gastos</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="LandedCost" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-green">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-calculator fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Cálculo de Landed Cost</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="OrdenImportacion" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-dark">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-lock fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Confirmación y Cierre</h6>
                </div>
            </a>
        </div>
    </div>

    <!-- Catálogos y Configuración -->
    <h4 class="mb-4 text-secondary font-weight-bold text-uppercase small border-bottom pb-2">Catálogos y Configuración</h4>
    <div class="row g-4">
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Paises" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-indigo">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-globe-americas fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Países</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Monedas" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-yellow">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-coins fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold text-dark">Monedas</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Importadores" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-purple">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-building fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Importadores</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Proveedor" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-teal">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-truck-loading fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Proveedores</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="Productos" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-red">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-box fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Productos</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="CategoriasArancelarias" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-brown">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-file-invoice-dollar fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Cat. Arancelarias</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="TasasCambio" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-pink">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-exchange-alt fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Tasas de Cambio</h6>
                </div>
            </a>
        </div>
        <div class="col-md-4 col-lg-3">
            <a asp-controller="ConfiguracionImpuestos" asp-action="Index" class="card h-100 shadow-sm border-0 text-decoration-none module-card card-primary">
                <div class="card-body text-center p-4">
                    <div class="icon-circle mb-3">
                        <i class="fas fa-cogs fs-2"></i>
                    </div>
                    <h6 class="card-title font-weight-bold">Impuestos</h6>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .module-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        color: white !important;
    }
    .module-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175)!important;
    }
    .icon-circle {
        height: 70px;
        width: 70px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.2);
    }
    
    /* Colores Personalizados */
    .card-blue { background: linear-gradient(45deg, #4e73df, #224abe); }
    .card-cyan { background: linear-gradient(45deg, #36b9cc, #258391); }
    .card-orange { background: linear-gradient(45deg, #fd7e14, #d96101); }
    .card-green { background: linear-gradient(45deg, #1cc88a, #13855c); }
    .card-dark { background: linear-gradient(45deg, #5a5c69, #373840); }
    .card-indigo { background: linear-gradient(45deg, #6610f2, #4e08bd); }
    .card-yellow { background: linear-gradient(45deg, #f6c23e, #dda20a); }
    .card-purple { background: linear-gradient(45deg, #6f42c1, #563d7c); }
    .card-teal { background: linear-gradient(45deg, #20c997, #17a2b8); }
    .card-red { background: linear-gradient(45deg, #e74a3b, #be2617); }
    .card-brown { background: linear-gradient(45deg, #858796, #60616f); }
    .card-pink { background: linear-gradient(45deg, #e83e8c, #c51162); }
    .card-primary { background: linear-gradient(45deg, #007bff, #0056b3); }

    .card-yellow .icon-circle { background: rgba(0,0,0,0.1); }
</style>

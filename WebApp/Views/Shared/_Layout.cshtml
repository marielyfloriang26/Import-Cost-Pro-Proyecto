<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
               <!-- <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WebApp</a> -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
    ImportCost<span class="app-accent">Pro</span> <!-- Agregado el span para dar color solo a 'App' -->
</a>



                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                           
                           
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                           
                           
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Módulos
                            </a>
                            
                            <ul class="dropdown-menu shadow-sm border-0" aria-labelledby="navbarDropdown">
                             
                                <li><h6 class="dropdown-header text-uppercase small font-weight-bold">Configuración y Catálogos</h6></li>
                                <li><a class="dropdown-item py-2" asp-controller="Paises" asp-action="Index">Mantenimiento de Países</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Monedas" asp-action="Index">Mantenimiento de Monedas</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Importadores" asp-action="Index">Mantenimiento de Importadores</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Proveedor" asp-action="Index">Mantenimiento de Proveedores</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Productos" asp-action="Index">Mantenimiento de Productos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="CategoriasArancelarias" asp-action="Index">Categorías Arancelarias</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="TasasCambio" asp-action="Index">Tasas de Cambio</a></li>
                                
                                 <li><a class="dropdown-item py-2" asp-controller="OrdenImportacion" asp-action="Index">Órdenes de importación</a></li>
                                 <li><hr class="dropdown-divider"></li>
                                 
                               
                                <li><a class="dropdown-item py-2" asp-controller="GastosImportacion" asp-action="Index">Gastos de importación</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="LandedCost" asp-action="Index">Cálculo de Landed Cost</a></li>
                                
                                
                                <li><a class="dropdown-item py-2 fw-bold text-primary border-top" asp-controller="ConfiguracionImpuestos" asp-action="Index">Configuración de Impuestos</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
                </div>
                </nav>
                </header>
                <div class="container">
                <main role="main" class="pb-3">
                @RenderBody()
                </main>
                </div>

                <footer class="border-top footer text-muted">
                <div class="container text-center">
                &copy; 2026 - ImportCost Pro - Sistema de Gestión de Importaciones
                </div>
                </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<Capa_de_Negocio.DTOs.ProveedorDTO>

@{
    ViewData["Title"] = "Mantenimiento de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Proveedores</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Crear proveedor</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-with-dismiss="alert" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-with-dismiss="alert" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.85rem;">
                    <tr>
                        <th class="p-3">ID</th>
                        <th class="p-3">Proveedor / Razón Social</th>
                        <th class="p-3">Contacto</th>
                        <th class="p-3">Procedencia</th>
                        <th class="p-3">Moneda Base</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No hay proveedores registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 text-secondary font-monospace">#@item.Id</td>
                                <td class="p-3 font-weight-bold text-dark">@item.Nombre</td>
                                <td class="p-3">
                                    <div class="d-flex flex-column" style="font-size: 0.9rem;">
                                        <span><i class="bi bi-envelope text-muted me-1"></i>@(string.IsNullOrEmpty(item.Correo) ? "Sin correo" : item.Correo)</span>
                                        <small class="text-muted"><i class="bi bi-telephone text-muted me-1"></i>@(string.IsNullOrEmpty(item.Telefono) ? "Sin teléfono" : item.Telefono)</small>
                                    </div>
                                </td>
                                <td class="p-3">
                                    <span class="badge bg-secondary px-2 py-1">@item.PaisNombre</span>
                                </td>
                                <td class="p-3 font-weight-bold text-secondary">
                                    <span class="badge bg-light text-dark border px-2 py-1 font-monospace">@item.MonedaNombre</span>
                                </td>
                                <td class="p-3">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                <td class="p-3 text-end">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-1">Editar</a>
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
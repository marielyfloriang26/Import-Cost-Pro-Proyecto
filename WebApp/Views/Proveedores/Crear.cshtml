@model WebApp.Models.ProveedorCrearViewModel

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="container py-4 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-8">
            
            <div class="mb-3">
                <a asp-action="Index" class="text-decoration-none text-muted small fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4 border-bottom bg-light rounded-top-3">
                    <h2 class="h4 mb-1 text-dark fw-bold">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Registrar Nuevo Proveedor
                    </h2>
                    <p class="text-muted small mb-0">Complete los datos requeridos para dar de alta al suplidor internacional.</p>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Samsung Electronics Co." />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="Correo" type="email" class="form-control" placeholder="ejemplo@proveedor.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Telefono" class="form-label fw-semibold text-secondary small"></label>
                                <input asp-for="Telefono" class="form-control" placeholder="Ej. +1 809-555-0199" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="PaisId" class="form-label fw-semibold text-secondary small"></label>
                                <select asp-for="PaisId" class="form-select">
                                    <option value="">-- Seleccione un País --</option>
                                    @if (Model.Paises != null)
                                    {
                                        @foreach (var pais in Model.Paises)
                                        {
                                            <option value="@pais.Key">@pais.Value</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="PaisId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="MonedaPrincipalId" class="form-label fw-semibold text-secondary small"></label>
                                <select asp-for="MonedaPrincipalId" class="form-select">
                                    <option value="">-- Seleccione una Moneda --</option>
                                    @if (Model.Monedas != null)
                                    {
                                        @foreach (var moneda in Model.Monedas)
                                        {
                                            <option value="@moneda.Key">@moneda.Value</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="MonedaPrincipalId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="text-end pt-3 border-top">
                            <a asp-action="Index" class="btn btn-light fw-semibold me-2 px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">Guardar Proveedor</button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
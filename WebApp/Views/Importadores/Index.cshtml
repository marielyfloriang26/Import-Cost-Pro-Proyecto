@model IEnumerable<WebApp.ViewModels.ImportadorViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Importadores</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Crear importador</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase">
                    <tr>
                        <th class="p-3">Nombre o razón social</th>
                        <th class="p-3">RNC / ID Fiscal</th>
                        <th class="p-3">País</th>
                        <th class="p-3">Teléfono</th>
                        <th class="p-3">Correo electrónico</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No hay importadores registrados.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3 font-weight-bold text-dark">@item.NombreRazonSocial</td>
                            <td class="p-3 font-monospace">@item.RncIdentificacion</td>
                            <td class="p-3">@item.NombrePais</td>
                            <td class="p-3 text-secondary">@(item.Telefono ?? "N/A")</td>
                            <td class="p-3 text-secondary">@(item.Correo ?? "N/A")</td>
                            <td class="p-3">
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success px-2 py-1">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                }
                            </td>
                            <td class="p-3 text-end">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-1">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model WebApp.ViewModels.ImportadorViewModel

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="text-dark font-weight-bold mb-3">Crear importador</h3>
        <hr />
        
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger font-weight-bold"></div>

            <div class="mb-3">
                <label asp-for="NombreRazonSocial" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="NombreRazonSocial" class="form-control" placeholder="Ej. Importadora del Caribe SRL" maxlength="150" />
                <span asp-validation-for="NombreRazonSocial" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RncIdentificacion" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="RncIdentificacion" class="form-control" placeholder="Ej. 101123456 o Cédula" maxlength="20" />
                <span asp-validation-for="RncIdentificacion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaisId" class="form-label font-weight-bold text-secondary"></label>
                <select asp-for="PaisId" class="form-select" asp-items="ViewBag.Paises">
                    <option value="">-- Seleccione un país --</option>
                </select>
                <span asp-validation-for="PaisId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="Telefono" class="form-control" placeholder="Ej. 809-555-1234" maxlength="20" />
                <span asp-validation-for="Telefono" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="Correo" type="email" class="form-control" placeholder="Ej. contacto@empresa.com" maxlength="100" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Direccion" class="form-label font-weight-bold text-secondary"></label>
                <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Dirección física..." maxlength="250"></textarea>
                <span asp-validation-for="Direccion" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Estado" class="form-check-input" type="checkbox" />
                <label asp-for="Estado" class="form-check-label font-weight-bold text-secondary">¿Importador Activo?</label>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Volver atrás</a>
                <button type="submit" class="btn btn-primary px-4">Crear importador</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
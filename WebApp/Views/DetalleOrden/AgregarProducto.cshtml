@model WebApp.ViewModels.ProductoOrdenViewModel

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="text-dark font-weight-bold mb-3">Agregar producto a la orden</h3>
        <hr />
        
        <form asp-action="AgregarProducto" method="post">
            <input type="hidden" asp-for="OrdenImportacionId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger font-weight-bold"></div>

            <div class="mb-3">
                <label asp-for="ProductoId" class="form-label font-weight-bold text-secondary"></label>
                <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.Productos">
                    <option value="">-- Seleccione un producto activo --</option>
                </select>
                <span asp-validation-for="ProductoId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cantidad" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="Cantidad" type="number" step="any" class="form-control" placeholder="Ej. 100 o 25.5" />
                <span asp-validation-for="Cantidad" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecioUnitarioFob" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="PrecioUnitarioFob" type="number" step="0.01" class="form-control" placeholder="0.00" />
                <span asp-validation-for="PrecioUnitarioFob" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MargenGananciaDeseado" class="form-label font-weight-bold text-secondary"></label>
                <div class="input-group">
                    <input asp-for="MargenGananciaDeseado" type="number" step="0.01" class="form-control" placeholder="Ej. 30" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="MargenGananciaDeseado" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" asp-route-id="@Model.OrdenImportacionId" class="btn btn-outline-secondary px-4">Volver atrás</a>
                <button type="submit" class="btn btn-primary px-4">Agregar producto</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model WebApp.ViewModels.ProductoOrdenViewModel

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="text-dark font-weight-bold mb-3">Editar producto asignado</h3>
        <hr />
        
        <form asp-action="EditarProducto" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="OrdenImportacionId" />
            <input type="hidden" asp-for="ProductoId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger font-weight-bold"></div>

            <div class="mb-3">
                <label class="form-label font-weight-bold text-secondary">Producto (No modificable)</label>
                <input type="text" class="form-control bg-light text-muted" value="@Model.NombreProducto" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Cantidad" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="Cantidad" type="number" step="any" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecioUnitarioFob" class="form-label font-weight-bold text-secondary"></label>
                <input asp-for="PrecioUnitarioFob" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PrecioUnitarioFob" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MargenGananciaDeseado" class="form-label font-weight-bold text-secondary"></label>
                <div class="input-group">
                    <input asp-for="MargenGananciaDeseado" type="number" step="0.01" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="MargenGananciaDeseado" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" asp-route-id="@Model.OrdenImportacionId" class="btn btn-outline-secondary px-4">Volver atrás</a>
                <button type="submit" class="btn btn-warning text-white px-4">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
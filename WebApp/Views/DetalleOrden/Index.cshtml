@model Capa_de_Negocio.DTOs.OrdenResumenFobDto
@using Capa_de_Datos.Enums

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4 p-4 bg-dark text-white rounded">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="text-uppercase text-muted small font-weight-bold">Orden de Importación</span>
                <h2 class="font-weight-bold mb-1">Nº @Model.NumeroOrden</h2>
                <p class="mb-0 text-light opacity-75">Proveedor: <strong>@Model.ProveedorNombre</strong></p>
            </div>
            <div class="text-end">
                <span class="text-muted small d-block mb-1">ESTADO</span>
                @if (Model.EstadoOrden == EstadoOrden.Abierta)
                {
                    <span class="badge bg-success fs-5 px-3">Abierta</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-5 px-3">@Model.EstadoOrden</span>
                }
            </div>
        </div>
    </div>

    @if (Model.TieneProductosSinDimensiones)
    {
        <div class="alert alert-warning border-0 shadow-sm" role="alert">
            <strong>⚠️ Nota de cubicación:</strong> Uno o más productos no tienen sus dimensiones configuradas. El volumen se mostrará como no disponible y bloqueará el cálculo del Landed Cost si existen gastos distribuidos por volumen.
        </div>
    }

    <div class="mb-4 d-flex gap-2">
        @if (Model.EstadoOrden == EstadoOrden.Abierta)
        {
            <a asp-action="AgregarProducto" asp-route-ordenId="@Model.OrdenId" class="btn btn-primary px-4 shadow-sm">＋ Agregar Producto</a>
            <button class="btn btn-outline-info px-4 shadow-sm">📋 Registrar Gastos</button>
            <button class="btn btn-outline-success px-4 shadow-sm">🧮 Calcular Landed Cost</button>
        }
        else
        {
            <button class="btn btn-secondary px-4" disabled>＋ Agregar Producto (Bloqueado)</button>
            <button class="btn btn-secondary px-4" disabled>📋 Registrar Gastos (Bloqueado)</button>
            <button class="btn btn-secondary px-4" disabled>🧮 Calcular Landed Cost (Bloqueado)</button>
        }
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light font-weight-bold text-secondary text-uppercase py-3">
            Productos en esta orden
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="p-3">Producto</th>
                        <th class="p-3 text-center">Cantidad</th>
                        <th class="p-3 text-end">Precio Unitario FOB</th>
                        <th class="p-3 text-end">FOB Total</th>
                        <th class="p-3 text-end">Peso Total</th>
                        <th class="p-3 text-end">Volumen Total</th>
                        <th class="p-3 text-center">Margen Deseado</th>
                        @if (Model.EstadoOrden == EstadoOrden.Abierta)
                        {
                            <th class="p-3 text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Productos.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No se han añadido productos a esta orden todavía.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Productos)
                    {
                        <tr>
                            <td class="p-3">
                                <span class="font-weight-bold text-dark">@item.NombreProducto</span><br />
                                <small class="text-muted">Ref: @item.CodigoReferencia</small>
                            </td>
                            <td class="p-3 text-center font-weight-bold text-secondary">@item.Cantidad.ToString("N2")</td>
                            <td class="p-3 text-end font-monospace">@item.PrecioUnitarioFob.ToString("N2") @Model.MonedaNombre</td>
                            <td class="p-3 text-end font-weight-bold text-dark font-monospace">@item.FobTotal.ToString("N2") @Model.MonedaNombre</td>
                            <td class="p-3 text-end text-secondary">@item.PesoTotal.ToString("N2") kg</td>
                            <td class="p-3 text-end text-secondary">
                                @(item.VolumenTotal.HasValue ? $"{item.VolumenTotal.Value:N2} cm³" : "No disponible")
                            </td>
                            <td class="p-3 text-center"><span class="badge bg-light text-dark border px-2 py-1">@item.MargenGananciaDeseado.ToString("N0")%</span></td>
                            @if (Model.EstadoOrden == EstadoOrden.Abierta)
                            {
                                <td class="p-3 text-end">
                                    <a asp-action="EditarProducto" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-1">Editar</a>
                                    <a asp-action="EliminarProducto" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Quitar</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 offset-md-6">
            <div class="card shadow-sm border-0 p-4 bg-light">
                <h5 class="font-weight-bold text-secondary mb-3 text-uppercase small">Resumen FOB de la Orden</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Cantidad total de productos:</span>
                    <span class="font-weight-bold text-dark">@Model.CantidadTotalProductos.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Peso total estimado:</span>
                    <span class="font-weight-bold text-dark">@Model.PesoTotalOrden.ToString("N2") kg</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Volumen total estimado:</span>
                    <span class="font-weight-bold text-dark">@Model.VolumenTotalOrden.ToString("N2") cm³</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="h6 font-weight-bold text-secondary">FOB Total Orden:</span>
                    <span class="h5 font-weight-bold text-primary font-monospace">@Model.FobTotalOrden.ToString("N2") @Model.MonedaNombre</span>
                </div>
            </div>
        </div>
    </div>
</div>
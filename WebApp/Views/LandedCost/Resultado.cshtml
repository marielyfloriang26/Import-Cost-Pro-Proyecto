@model WebApp.Models.ViewModels.LandedCostCalculoViewModel

@{
    ViewData["Title"] = Model.EsCalculoOficial ? "Resultado Oficial de Landed Cost" : "Vista Previa de Landed Cost";
    var calculo = Model.Calculo!;
}

<div class="container-fluid mt-4">
    <!-- Encabezado y Acciones -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-3 d-print-none">
        <div>
            <h2 class="text-dark font-weight-bold mb-0">
                <i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>
                @(Model.EsCalculoOficial ? "Resultado Oficial" : "Vista Previa"): Orden @calculo.NumeroOrden
            </h2>
            <span class="text-secondary small text-uppercase font-weight-bold">Fecha de Cálculo: @calculo.FechaCalculo.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Volver</a>
            <button onclick="window.print()" class="btn btn-outline-dark me-2"><i class="bi bi-printer me-1"></i> Imprimir</button>
            
            @if (!Model.EsCalculoOficial)
            {
                <form asp-action="GuardarOficial" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" value="@calculo.OrdenId" />
                    <button type="submit" class="btn btn-success px-4 shadow-sm fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Guardar como Cálculo Oficial
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- 1. Tabla con el detalle por producto (Pág. 123-125) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 font-weight-bold text-dark">Detalle por Artículo</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0" style="font-size: 0.8rem;">
                <thead class="bg-light text-secondary text-uppercase small text-center">
                    <tr>
                        <th class="p-2">Producto</th>
                        <th class="p-2">Cantidad</th>
                        <th class="p-2">FOB Original</th>
                        <th class="p-2">FOB Local</th>
                        <th class="p-2">Flete Asignado</th>
                        <th class="p-2">Seguro Asignado</th>
                        <th class="p-2 bg-light">CIF</th>
                        <th class="p-2">Arancel</th>
                        <th class="p-2">Imp. Selectivo</th>
                        <th class="p-2">Tasa Servicio</th>
                        <th class="p-2">ITBIS</th>
                        <th class="p-2">Gastos Locales</th>
                        <th class="p-2 bg-light">Costo Total</th>
                        <th class="p-2">Costo Unitario</th>
                        <th class="p-2">Margen %</th>
                        <th class="p-2 text-primary font-weight-bold">Precio Sugerido</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in calculo.Detalles)
                    {
                        <tr class="text-end">
                            <td class="text-start font-weight-bold">@item.NombreProducto</td>
                            <td>@item.Cantidad.ToString("N0")</td>
                            <td>@item.FobOriginal.ToString("N2")</td>
                            <td>@item.FobLocal.ToString("N2")</td>
                            <td>@item.FleteAsignado.ToString("N2")</td>
                            <td>@item.SeguroAsignado.ToString("N2")</td>
                            <td class="bg-light font-weight-bold">@item.Cif.ToString("N2")</td>
                            <td>@item.Arancel.ToString("N2") <small class="d-block text-muted">(@item.PorcentajeArancelUsado%)</small></td>
                            <td>@item.ImpuestoSelectivo.ToString("N2") <small class="d-block text-muted">(@item.PorcentajeSelectivoUsado%)</small></td>
                            <td>@item.TasaServicioAduanal.ToString("N2")</td>
                            <td>@item.Itbis.ToString("N2")</td>
                            <td>@item.GastosLocalesAsignados.ToString("N2")</td>
                            <td class="bg-light font-weight-bold">@item.CostoTotalImportado.ToString("N2")</td>
                            <td class="font-weight-bold text-dark">@item.CostoUnitarioImportado.ToString("N2")</td>
                            <td class="text-center">@item.MargenDeseado%</td>
                            <td class="font-weight-bold text-primary">@item.PrecioVentaSugerido.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. Resumen general DEBAJO de la tabla (Pág. 125-126) -->
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 font-weight-bold text-primary text-uppercase small">Resumen de Totales</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Moneda local usada:</span>
                            <span class="font-weight-bold text-dark">@calculo.CodigoIsoMonedaLocal</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Tasa de cambio usada para la orden:</span>
                            <span class="font-weight-bold text-dark">@calculo.TasaCambioUsada.ToString("N4")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-top-2">
                            <span class="text-secondary small font-weight-bold">FOB total original:</span>
                            <span class="font-weight-bold text-dark">@calculo.FobTotalOriginal.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small font-weight-bold">FOB total local:</span>
                            <span class="font-weight-bold text-dark">@calculo.FobTotalLocal.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Flete total:</span>
                            <span class="font-weight-bold text-dark">@calculo.FleteTotalLocal.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Seguro total:</span>
                            <span class="font-weight-bold text-dark">@calculo.SeguroTotalLocal.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 bg-light">
                            <span class="text-dark font-weight-bold">CIF total:</span>
                            <span class="text-primary font-weight-bold fs-5">@calculo.CifTotal.ToString("N2")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 font-weight-bold text-primary text-uppercase small">Impuestos y Consolidado</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Total arancel:</span>
                            <span class="font-weight-bold text-dark">@calculo.TotalArancel.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Total impuesto selectivo:</span>
                            <span class="font-weight-bold text-dark">@calculo.TotalImpuestoSelectivo.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Total tasa servicio aduanal:</span>
                            <span class="font-weight-bold text-dark">@calculo.TotalTasaServicio.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2">
                            <span class="text-secondary small">Total ITBIS:</span>
                            <span class="font-weight-bold text-dark">@calculo.TotalItbis.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-top">
                            <span class="text-secondary small">Total gastos locales:</span>
                            <span class="font-weight-bold text-dark">@calculo.TotalGastosLocales.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 bg-success text-white">
                            <span class="font-weight-bold text-uppercase">Costo total de importación:</span>
                            <span class="font-weight-bold fs-4">@calculo.CostoTotalImportacion.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 bg-light">
                            <span class="text-secondary small font-weight-bold">Cantidad total importada:</span>
                            <span class="font-weight-bold text-dark">@calculo.CantidadTotalImportada.ToString("N0")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @if (calculo.EstadoOrden == Capa_de_Datos.Enums.EstadoOrden.Calculada && Model.EsCalculoOficial)
    {
        <div class="mt-4 text-center d-print-none mb-5">
            <div class="alert alert-info border-0 shadow-sm d-inline-block px-5">
                <p class="mb-3">El cálculo ha sido guardado exitosamente. Ahora puede proceder a cerrar la orden para hacerla inmutable.</p>
                <a asp-controller="ConfirmacionCierre" asp-action="Confirmar" asp-route-id="@calculo.OrdenId" class="btn btn-dark btn-lg px-5 shadow-sm fw-bold">
                    <i class="bi bi-lock me-2"></i> Confirmación y cierre de orden
                </a>
            </div>
        </div>
    }
</div>

<style>
    .table th, .table td { vertical-align: middle; }
    .list-group-item { border-left: none; border-right: none; }
    
    @@media print {
        .d-print-none { display: none !important; }
        .container-fluid { padding: 0 !important; }
        .card { border: 1px solid #dee2e6 !important; box-shadow: none !important; }
        .table { font-size: 0.7rem !important; }
        .bg-light { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; }
    }
</style>

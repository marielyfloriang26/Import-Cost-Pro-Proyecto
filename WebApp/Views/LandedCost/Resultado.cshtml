@model WebApp.Models.ViewModels.LandedCostCalculoViewModel

@{
    ViewData["Title"] = Model.EsCalculoOficial ? "Resultado Oficial de Landed Cost" : "Vista Previa de Landed Cost";
    var calculo = Model.Calculo!;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h2 class="text-dark font-weight-bold mb-0">
                <i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>
                @(Model.EsCalculoOficial ? "Resultado Oficial" : "Vista Previa"): Orden @calculo.NumeroOrden
            </h2>
            <span class="text-secondary small text-uppercase font-weight-bold">Fecha de Cálculo: @calculo.FechaCalculo.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <div class="d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">Volver</a>
            <button onclick="window.print()" class="btn btn-outline-dark me-2"><i class="bi bi-printer me-1"></i> Imprimir</button>
            
            @if (!Model.EsCalculoOficial)
            {
                <form asp-action="GuardarOficial" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ordenId" value="@calculo.OrdenId" />
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Guardar como Cálculo Oficial
                    </button>
                </form>
            }
            else if (calculo.EstadoOrden == Capa_de_Datos.Enums.EstadoOrden.Calculada)
            {
                <a asp-controller="ConfirmacionCierre" asp-action="Confirmar" asp-route-id="@calculo.OrdenId" class="btn btn-dark px-4 shadow-sm">
                    <i class="bi bi-lock me-1"></i> Cerrar Orden
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4 mx-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="row mx-1">
        <!-- Resumen General -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 mb-4 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 font-weight-bold text-primary text-uppercase small">Resumen de la Orden</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="small text-secondary text-uppercase d-block font-weight-bold">Moneda Local</label>
                        <span class="fs-5 text-dark">@calculo.CodigoIsoMonedaLocal</span>
                    </div>
                    <div class="mb-3">
                        <label class="small text-secondary text-uppercase d-block font-weight-bold">Tasa de Cambio (FOB)</label>
                        <span class="text-dark">1 @calculo.NumeroOrden = @calculo.TasaCambioUsada.ToString("N4") @calculo.CodigoIsoMonedaLocal</span>
                    </div>
                    <hr />
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">FOB Total Local:</span>
                        <span class="font-weight-bold text-dark">@calculo.FobTotalLocal.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Flete Total Local:</span>
                        <span class="font-weight-bold text-dark">@calculo.FleteTotalLocal.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Seguro Total Local:</span>
                        <span class="font-weight-bold text-dark">@calculo.SeguroTotalLocal.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between border-top pt-2">
                        <span class="text-dark font-weight-bold">CIF Total:</span>
                        <span class="text-primary font-weight-bold">@calculo.CifTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Totales de Impuestos y Gastos -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 mb-4 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 font-weight-bold text-primary text-uppercase small">Impuestos y Gastos</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Total Arancel:</span>
                        <span class="font-weight-bold text-dark">@calculo.TotalArancel.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Impuesto Selectivo:</span>
                        <span class="font-weight-bold text-dark">@calculo.TotalImpuestoSelectivo.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Tasa Servicio (@calculo.PorcentajeTasaAduanal%):</span>
                        <span class="font-weight-bold text-dark">@calculo.TotalTasaServicio.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Total ITBIS (@calculo.PorcentajeItbisGeneral%):</span>
                        <span class="font-weight-bold text-dark">@calculo.TotalItbis.ToString("N2")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-secondary small">Gastos Locales:</span>
                        <span class="font-weight-bold text-dark">@calculo.TotalGastosLocales.ToString("N2")</span>
                    </div>
                    <hr />
                    <div class="text-center mt-3 bg-light p-3 rounded">
                        <label class="small text-secondary text-uppercase d-block mb-1">Costo Total Importación</label>
                        <span class="fs-3 font-weight-bold text-success">@calculo.CodigoIsoMonedaLocal @calculo.CostoTotalImportacion.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detalle por Producto -->
        <div class="col-lg-12 mt-2">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 font-weight-bold text-dark">Detalle por Artículo</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light text-secondary text-uppercase small">
                            <tr>
                                <th class="p-3">Producto</th>
                                <th class="p-3 text-center">Cant.</th>
                                <th class="p-3 text-end">FOB Local</th>
                                <th class="p-3 text-end">Flete/Seguro</th>
                                <th class="p-3 text-end bg-light">CIF</th>
                                <th class="p-3 text-end">Arancel</th>
                                <th class="p-3 text-end">Otros Imp.</th>
                                <th class="p-3 text-end">Gastos Loc.</th>
                                <th class="p-3 text-end bg-light">Costo Total</th>
                                <th class="p-3 text-end font-weight-bold text-dark">Costo Unit.</th>
                                <th class="p-3 text-center">Margen</th>
                                <th class="p-3 text-end font-weight-bold text-primary">Precio Sugerido</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in calculo.Detalles)
                            {
                                <tr>
                                    <td class="p-3 font-weight-bold text-dark">@item.NombreProducto</td>
                                    <td class="p-3 text-center">@item.Cantidad.ToString("N0")</td>
                                    <td class="p-3 text-end">@item.FobLocal.ToString("N2")</td>
                                    <td class="p-3 text-end">@((item.FleteAsignado + item.SeguroAsignado).ToString("N2"))</td>
                                    <td class="p-3 text-end bg-light font-weight-bold">@item.Cif.ToString("N2")</td>
                                    <td class="p-3 text-end">@item.Arancel.ToString("N2") <small class="d-block text-muted">@item.PorcentajeArancelUsado%</small></td>
                                    <td class="p-3 text-end">@((item.ImpuestoSelectivo + item.TasaServicioAduanal + item.Itbis).ToString("N2"))</td>
                                    <td class="p-3 text-end">@item.GastosLocalesAsignados.ToString("N2")</td>
                                    <td class="p-3 text-end bg-light font-weight-bold">@item.CostoTotalImportado.ToString("N2")</td>
                                    <td class="p-3 text-end font-weight-bold text-dark">@item.CostoUnitarioImportado.ToString("N2")</td>
                                    <td class="p-3 text-center text-muted">@item.MargenDeseado%</td>
                                    <td class="p-3 text-end font-weight-bold text-primary fs-6">@item.PrecioVentaSugerido.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .d-print-none { display: none !important; }
        .card { box-shadow: none !important; border: 1px solid #ddd !important; }
        .bg-light { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; }
    }
</style>

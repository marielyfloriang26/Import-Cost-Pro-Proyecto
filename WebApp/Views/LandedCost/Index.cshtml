@model WebApp.Models.ViewModels.LandedCostIndexViewModel

@{
    ViewData["Title"] = "Cálculo de Landed Cost";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 font-weight-bold"><i class="bi bi-calculator me-2"></i>Cálculo de Landed Cost</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-secondary mb-4">Seleccione una orden de importación en estado <strong>Abierta</strong> para realizar el cálculo del costo real importado.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                </div>
            }

            <form asp-action="Calcular" method="post">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="SelectedOrdenId" class="form-label font-weight-bold text-dark text-uppercase small">Orden de Importación</label>
                        <select asp-for="SelectedOrdenId" asp-items="Model.OrdenesAbiertas" class="form-select form-select-lg shadow-sm border-0 bg-light">
                            <option value="">-- Seleccione una orden --</option>
                        </select>
                        <span asp-validation-for="SelectedOrdenId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-play-circle-fill me-2"></i> Calcular Landed Cost
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model WebApp.Models.ViewModels.LandedCostIndexViewModel

@{
    ViewData["Title"] = "Cálculo de Landed Cost";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0 font-weight-bold"><i class="bi bi-calculator me-2"></i>Cálculo de Landed Cost</h5>
        </div>
        <div class="card-body p-4">
            <p class="text-secondary mb-4">Seleccione una orden de importación en estado <strong>Abierta</strong> para realizar el cálculo del costo real importado.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">
                    <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                </div>
            }

            <form asp-action="Calcular" method="post">
                <div class="row align-items-end">
                    <div class="col-md-8 mb-3">
                        <label asp-for="SelectedOrdenId" class="form-label font-weight-bold text-dark text-uppercase small">Orden de Importación</label>
                        <select asp-for="SelectedOrdenId" asp-items="Model.OrdenesAbiertas" class="form-select form-select-lg shadow-sm border-0 bg-light">
                            <option value="">-- Seleccione una orden --</option>
                        </select>
                        <span asp-validation-for="SelectedOrdenId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-play-circle-fill me-2"></i> Calcular Landed Cost
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-5">
        <h6 class="text-uppercase text-secondary font-weight-bold mb-3 border-bottom pb-2">¿Qué incluye este cálculo?</h6>
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <span class="d-block font-weight-bold text-dark">Distribución de Gastos</span>
                        <small class="text-muted">Prorrateo de flete, seguro y gastos locales por valor FOB, peso, volumen o cantidad.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <span class="d-block font-weight-bold text-dark">Impuestos y Tasas</span>
                        <small class="text-muted">Cálculo automático de Aranceles, Impuesto Selectivo, Tasa Aduanal e ITBIS según configuración.</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>
                    <div>
                        <span class="d-block font-weight-bold text-dark">Precio Sugerido</span>
                        <small class="text-muted">Determinación del precio de venta final basado en el margen de ganancia configurado por producto.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

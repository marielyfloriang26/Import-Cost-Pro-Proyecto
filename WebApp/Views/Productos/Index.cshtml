@model IEnumerable<Capa_de_Negocio.ViewModels.ProductoViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Productos</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Crear producto</a>
    </div>

    @* alertas de exito o error conectadas al controlador *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.85rem;">
                    <tr>
                        <th class="p-3">Código (SKU)</th>
                        <th class="p-3">Producto / Nombre</th>
                        <th class="p-3">Origen y Categoría</th>
                        <th class="p-3">Peso / U. Medida</th>
                        <th class="p-3">Dimensiones (L x A x A)</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No hay productos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                @* Código / Referencia *@
                                <td class="p-3 font-weight-bold text-secondary font-monospace">@item.CodigoReferencia</td>
                                
                                @* Nombre del Producto *@
                                <td class="p-3 font-weight-bold text-dark">@item.Nombre</td>
                                
                                @* País de Origen y Categoría Arancelaria *@
                                <td class="p-3">
                                    <div class="d-flex flex-column" style="font-size: 0.9rem;">
                                        <span><i class="bi bi-globe2 text-muted me-1"></i>@item.PaisOrigenNombre</span>
                                        <small class="text-muted"><i class="bi bi-tag text-muted me-1"></i>@item.CategoriaNombre</small>
                                    </div>
                                </td>
                                
                                @* Peso Unitario y Unidad de Medida *@
                                <td class="p-3">
                                    <div class="d-flex flex-column" style="font-size: 0.9rem;">
                                        <span>@item.PesoUnitario.ToString("N3") Kg</span>
                                        <small class="text-muted font-monospace">@item.UnidadMedidaSelected</small>
                                    </div>
                                </td>

                                @* Dimensiones Físicas Opcionales *@
                                <td class="p-3">
                                    @if (item.Largo.HasValue && item.Ancho.HasValue && item.Alto.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                            @item.Largo.Value.ToString("N1") x @item.Ancho.Value.ToString("N1") x @item.Alto.Value.ToString("N1") cm
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic small" style="font-style: italic;">Sin dimensiones</span>
                                    }
                                </td>
                                
                                @* Estado (Activo / Inactivo) *@
                                <td class="p-3">
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success px-2 py-1">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-2 py-1">Inactivo</span>
                                    }
                                </td>
                                
                                @* Botones de Accion (El de eliminar se dispara por formulario seguro) *@
                                <td class="p-3 text-end">
                                    <div class="d-flex justify-content-end align-items-center">
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-2">Editar</a>
                                        
                                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
    Eliminar
</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
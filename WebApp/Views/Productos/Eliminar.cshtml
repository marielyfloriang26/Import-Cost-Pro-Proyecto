@model Capa_de_Negocio.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 550px; border-radius: 12px;">
        <div class="card-body p-4 text-center">
            
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle" style="font-size: 3.5rem;"></i>
            </div>
            
            <h3 class="text-dark font-weight-bold mb-3" style="font-size: 1.5rem;">
                ¿Está seguro que desea eliminar este producto?
            </h3>
            
            <div class="alert alert-light border text-start my-4 p-3" style="background-color: #f8f9fa; border-radius: 8px;">
                <div class="mb-2">
                    <span class="text-muted small d-block">Código (SKU)</span>
                    <strong class="text-dark font-monospace" style="font-size: 1.1rem;">@Model.CodigoReferencia</strong>
                </div>
                <div class="mb-2">
                    <span class="text-muted small d-block">Nombre del Producto</span>
                    <strong class="text-dark">@Model.Nombre</strong>
                </div>
                <div>
                    <span class="text-muted small d-block">Categoría Arancelaria</span>
                    <strong class="text-secondary small">@Model.CategoriaNombre</strong>
                </div>
            </div>
            
            <p class="text-muted small mb-4">
                * Nota: El sistema rechazará la eliminación física si este producto se encuentra amarrado o asociado a alguna orden de importación vigente o histórica.
            </p>
            
            <hr class="text-muted opacity-25" />

            <form asp-action="EliminarConfirmado" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <a asp-action="Index" class="btn btn-light px-4 fw-semibold" style="border-radius: 6px;">
                        Cancelar
                    </a>
                    
                    <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm" style="border-radius: 6px;">
                        Aceptar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
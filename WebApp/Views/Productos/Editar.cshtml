@model Capa_de_Negocio.ViewModels.ProductoViewModel

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body p-4">
            <h2 class="text-dark font-weight-bold mb-3">Editar Producto</h2>
            <hr />

            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="Id" />

                @* Bloque de alertas en caso de que fallen las reglas del profesor en el servidor *@
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <span>@error.ErrorMessage</span>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CodigoReferencia" class="form-label fw-bold">Código / Referencia (SKU)</label>
                    <input asp-for="CodigoReferencia" class="form-control font-monospace" />
                    <span asp-validation-for="CodigoReferencia" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaisOrigenId" class="form-label fw-bold">País de Origen</label>
                    <select asp-for="PaisOrigenId" class="form-select">
                        <option value="">-- Seleccione un País --</option>
                        @if (Model.PaisesOptions != null)
                        {
                            @foreach (var pais in Model.PaisesOptions)
                            {
                                <option value="@pais.Key">@pais.Value</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="PaisOrigenId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label fw-bold">Categoría Arancelaria</label>
                    <select asp-for="CategoriaId" class="form-select">
                        <option value="">-- Seleccione una Categoría --</option>
                        @if (Model.CategoriasOptions != null)
                        {
                            @foreach (var cat in Model.CategoriasOptions)
                            {
                                <option value="@cat.Key">@cat.Value</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PesoUnitario" class="form-label fw-bold">Peso Unitario</label>
                    <div class="input-group">
                        <input asp-for="PesoUnitario" class="form-control" type="number" step="0.001" />
                        <span class="input-group-text bg-light text-muted small">Kg</span>
                    </div>
                    <span asp-validation-for="PesoUnitario" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="UnidadMedidaSelected" class="form-label fw-bold">Unidad de Medida</label>
                    <select asp-for="UnidadMedidaSelected" class="form-select">
                        @foreach (var unidad in Model.UnidadesMedidaOptions)
                        {
                            <option value="@unidad">@unidad</option>
                        }
                    </select>
                    <span asp-validation-for="UnidadMedidaSelected" class="text-danger small"></span>
                </div>

                <div class="p-3 bg-light rounded mb-3 border">
                    <div class="d-flex align-items-center mb-2">
                        <span class="fw-bold text-dark small">Dimensiones (Largo x Ancho x Alto)</span>
                        <span class="badge bg-secondary ms-2 font-monospace" style="font-size: 0.65rem;">Opcionales juntas</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <input asp-for="Largo" class="form-control form-control-sm font-monospace" type="number" step="0.1" placeholder="Largo" />
                            <span asp-validation-for="Largo" class="text-danger tool-small" style="font-size: 0.75rem;"></span>
                        </div>
                        <div class="col-4">
                            <input asp-for="Ancho" class="form-control form-control-sm font-monospace" type="number" step="0.1" placeholder="Ancho" />
                            <span asp-validation-for="Ancho" class="text-danger tool-small" style="font-size: 0.75rem;"></span>
                        </div>
                        <div class="col-4">
                            <input asp-for="Alto" class="form-control form-control-sm font-monospace" type="number" step="0.1" placeholder="Alto" />
                            <span asp-validation-for="Alto" class="text-danger tool-small" style="font-size: 0.75rem;"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-bold">Descripción Adicional</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Estado" class="form-check-input" type="checkbox" />
                    <label asp-for="Estado" class="form-check-label fw-bold">Producto Activo</label>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
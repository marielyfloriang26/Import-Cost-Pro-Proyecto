@model Capa_de_Negocio.ViewModels.TasaCambioFormViewModel

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0 p-4">
        <h3 class="text-dark font-weight-bold mb-3">Editar tasa de cambio</h3>
        <hr />
        
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="IdTasaCambio" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger font-weight-bold"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MonedaOrigenId" class="form-label font-weight-bold text-secondary"></label>
                    <select asp-for="MonedaOrigenId" class="form-select" asp-items="ViewBag.Monedas">
                        <option value="">-- Seleccione Moneda --</option>
                    </select>
                    <span asp-validation-for="MonedaOrigenId" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MonedaDestinoId" class="form-label font-weight-bold text-secondary"></label>
                    <select asp-for="MonedaDestinoId" class="form-select" asp-items="ViewBag.Monedas">
                        <option value="">-- Seleccione Moneda --</option>
                    </select>
                    <span asp-validation-for="MonedaDestinoId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ValorTasa" class="form-label font-weight-bold text-secondary"></label>
                    <input asp-for="ValorTasa" class="form-control" type="number" step="0.000001" />
                    <span asp-validation-for="ValorTasa" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="FechaVigencia" class="form-label font-weight-bold text-secondary"></label>
                    <input asp-for="FechaVigencia" class="form-control" />
                    <span asp-validation-for="FechaVigencia" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Estado" class="form-check-input" type="checkbox" />
                <label asp-for="Estado" class="form-check-label font-weight-bold text-secondary">¿Tasa Activa?</label>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Volver atrás</a>
                <button type="submit" class="btn btn-warning text-white px-4">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
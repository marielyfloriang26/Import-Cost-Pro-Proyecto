@model IEnumerable<Capa_de_Negocio.ViewModels.TasaCambioIndexViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Tasas de Cambio</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Registrar tasa de cambio</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase">
                    <tr>
                        <th class="p-3">Moneda Origen</th>
                        <th class="p-3">Moneda Destino</th>
                        <th class="p-3">Valor de la Tasa</th>
                        <th class="p-3">Fecha de Vigencia</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay tasas de cambio registradas.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3 font-weight-bold text-dark">@item.MonedaOrigenNombre</td>
                            <td class="p-3 text-secondary">@item.MonedaDestinoNombre</td>
                            <td class="p-3 font-monospace">@Html.DisplayFor(modelItem => item.ValorTasa)</td>
                            <td class="p-3">@Html.DisplayFor(modelItem => item.FechaVigencia)</td>
                            <td class="p-3">
                                @if (item.Estado)
                                {
                                    <span class="badge bg-success px-2 py-1">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-2 py-1">Inactiva</span>
                                }
                            </td>
                            <td class="p-3 text-end">
                                <a asp-action="Editar" asp-route-id="@item.IdTasaCambio" class="btn btn-sm btn-warning text-white me-1">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.IdTasaCambio" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
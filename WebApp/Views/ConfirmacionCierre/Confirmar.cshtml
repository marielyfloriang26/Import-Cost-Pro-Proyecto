@model Capa_de_Negocio.DTOs.OrdenImportacionDto

@{
    ViewData["Title"] = "Confirmación y Cierre de Orden";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 text-center"><i class="bi bi-check-circle-fill me-2"></i>Finalizar Proceso de Importación</h5>
                </div>
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-3">¿Cerrar Orden @Model.NumeroOrden?</h3>
                    <p class="text-secondary mb-4">
                        Al confirmar el cierre, la orden pasará a estado <strong>CERRADA</strong>.
                        Esto bloqueará permanentemente cualquier modificación en sus productos, gastos y resultados del cálculo de <em>Landed Cost</em>.
                    </p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 small mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <form asp-action="Cerrar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mb-2">
                                <i class="bi bi-lock-fill me-2"></i> Confirmar y Cerrar Orden
                            </button>
                        </form>
                        <a asp-controller="LandedCost" asp-action="VerOficial" asp-route-ordenId="@Model.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i> Cancelar y Volver al Cálculo
                        </a>
                    </div>
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i> 
                        El cierre garantiza la trazabilidad histórica de la importación.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@model Capa_de_Negocio.DTOs.OrdenImportacionDto

@{
    ViewData["Title"] = "Confirmación y cierre de orden";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 font-weight-bold text-dark text-center">Confirmación y cierre de orden</h5>
                </div>
                <div class="card-body p-5 text-center">
                    <p class="fs-5 text-dark mb-5">
                        “¿Está seguro que desea cerrar esta orden de importación? Una vez cerrada, no podrá modificar sus datos, productos, gastos ni resultado de cálculo.”
                    </p>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm mb-4">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <div class="row justify-content-center">
                        <div class="col-md-5">
                            <form asp-action="Cerrar" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-dark btn-lg w-100 shadow-sm fw-bold">
                                    Aceptar
                                </button>
                            </form>
                        </div>
                        <div class="col-md-5">
                            <a asp-controller="OrdenImportacion" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-lg w-100">
                                Cancelar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

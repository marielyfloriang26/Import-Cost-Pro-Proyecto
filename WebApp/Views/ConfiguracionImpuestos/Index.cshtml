@model Capa_de_Negocio.ViewModels.ConfiguracionImpuestoViewModel

@{
    ViewData["Title"] = "Configuración de Impuestos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Configuración de Impuestos del Sistema</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 p-4 fs-6">
        <p class="text-muted small mb-4">
            <i class="bi bi-info-circle me-1 text-primary"></i> 
            Esta es una configuración general del sistema. Los valores definidos aquí serán utilizados como parámetros globales durante el cálculo oficial del <strong>Landed Cost</strong> para determinar los porcentajes e impuestos aplicables.
        </p>
        <hr class="text-muted opacity-25 mb-4" />

        <form asp-action="Guardar" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="PorcentajeItbis" class="form-label font-weight-bold text-secondary text-uppercase small" style="font-size: 0.85rem; letter-spacing: 0.5px;"></label>
                    <div class="input-group mt-1">
                        <input asp-for="PorcentajeItbis" class="form-control font-monospace font-weight-bold" type="number" step="0.01" min="0" max="100" placeholder="Ej: 18.00" value="@(Model?.PorcentajeItbis?.ToString() ?? "")" required />
                        <span class="input-group-text bg-light text-secondary font-weight-bold font-monospace">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeItbis" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text text-muted small mt-2">
                        Se aplicará sobre la base imponible del producto si su categoría arancelaria tiene marcado <strong>Aplica ITBIS: Sí</strong>.
                    </div>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="PorcentajeTasaAduanal" class="form-label font-weight-bold text-secondary text-uppercase small" style="font-size: 0.85rem; letter-spacing: 0.5px;"></label>
                    <div class="input-group mt-1">
                        <input asp-for="PorcentajeTasaAduanal" class="form-control font-monospace font-weight-bold" type="number" step="0.01" min="0" max="100" placeholder="Ej: 0.40" value="@(Model?.PorcentajeTasaAduanal?.ToString() ?? "")" required />
                        <span class="input-group-text bg-light text-secondary font-weight-bold font-monospace">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeTasaAduanal" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text text-muted small mt-2">
                        Porcentaje aplicado directamente sobre el valor <strong>CIF</strong> del producto para calcular la tasa de servicio de aduana.
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4 border-top pt-3">
                <button type="submit" class="btn btn-primary px-4 shadow-sm font-weight-bold">
                    <i class="bi bi-floppy me-1"></i> Guardar Configuración
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
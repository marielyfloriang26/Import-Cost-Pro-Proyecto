@model IEnumerable<Capa_de_Negocio.ViewModels.OrdenImportacionIndexViewModel>
@using Capa_de_Datos.Enums

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Órdenes de Importación</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Crear orden de importación</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase small">
                    <tr>
                        <th class="p-3">Número de orden</th>
                        <th class="p-3">Importador</th>
                        <th class="p-3">Proveedor</th>
                        <th class="p-3">País de origen</th>
                        <th class="p-3">Moneda</th>
                        <th class="p-3">Fecha de la orden</th>
                        <th class="p-3">Modalidad de transporte</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">FOB total</th>
                        <th class="p-3 text-end">Total estimado de importación</th>
                        <th class="p-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center py-4 text-muted">No hay órdenes de importación registradas.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr style="font-size: 0.9rem;">
                            <td class="p-3 font-weight-bold text-dark">@item.NumeroOrden</td>
                            <td class="p-3">@item.ImportadorNombre</td>
                            <td class="p-3">@item.ProveedorNombre</td>
                            <td class="p-3">@item.PaisOrigenNombre</td>
                            <td class="p-3">@item.MonedaNombre</td>
                            <td class="p-3">@item.FechaOrden.ToString("dd/MM/yyyy")</td>
                            <td class="p-3">
                                @switch (item.MedioTransporte)
                                {
                                    case MedioTransporte.Maritimo: <span>Marítimo</span> break;
                                    case MedioTransporte.Aereo: <span>Aéreo</span> break;
                                    case MedioTransporte.Terrestre: <span>Terrestre</span> break;
                                }
                            </td>
                            <td class="p-3">
                                @switch (item.EstadoOrden)
                                {
                                    case EstadoOrden.Abierta: <span class="badge bg-primary">Abierta</span> break;
                                    case EstadoOrden.Calculada: <span class="badge bg-info text-dark">Calculada</span> break;
                                    case EstadoOrden.Cerrada: <span class="badge bg-success">Cerrada</span> break;
                                    case EstadoOrden.Cancelada: <span class="badge bg-secondary">Cancelada</span> break;
                                }
                            </td>
                            <td class="p-3 text-end font-weight-bold">@item.FobTotal.ToString("N2")</td>
                            <td class="p-3 text-end">
                                @if (item.EstadoOrden == EstadoOrden.Calculada || item.EstadoOrden == EstadoOrden.Cerrada)
                                {
                                    <span class="text-success font-weight-bold">@item.TotalEstimadoLandedCost.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">---</span>
                                }
                            </td>
                            <td class="p-3 text-center">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Ver detalle">Detalle</a>
                                    
                                    @if (item.EstadoOrden == EstadoOrden.Abierta)
                                    {
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white mx-1">Editar</a>
                                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                    }
                                    else if (item.EstadoOrden == EstadoOrden.Calculada)
                                    {
                                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white ms-1">Editar</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

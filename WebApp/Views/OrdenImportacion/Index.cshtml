@model IEnumerable<Capa_de_Negocio.ViewModels.OrdenImportacionIndexViewModel>
@using Capa_de_Datos.Enums

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark font-weight-bold">Mantenimiento de Órdenes de Importación</h2>
        <a asp-action="Crear" class="btn btn-primary px-4 shadow-sm">Crear orden de importación</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase">
                    <tr>
                        <th class="p-3"># Orden</th>
                        <th class="p-3">Importador / Proveedor</th>
                        <th class="p-3">País / Moneda</th>
                        <th class="p-3">Fecha</th>
                        <th class="p-3">Estado</th>
                        <th class="p-3 text-end">Totales (Local)</th>
                        <th class="p-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No hay órdenes de importación registradas.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="p-3 font-weight-bold text-dark">@item.NumeroOrden</td>
                            <td class="p-3">
                                <div class="text-dark">@item.ImportadorNombre</div>
                                <div class="small text-secondary">@item.ProveedorNombre</div>
                            </td>
                            <td class="p-3">
                                <div class="text-dark">@item.PaisOrigenNombre</div>
                                <div class="small text-secondary">@item.MonedaNombre</div>
                            </td>
                            <td class="p-3 text-secondary">@Html.DisplayFor(modelItem => item.FechaOrden)</td>
                            <td class="p-3">
                                @switch (item.EstadoOrden)
                                {
                                    case EstadoOrden.Abierta:
                                        <span class="badge bg-primary px-2 py-1">Abierta</span>
                                        break;
                                    case EstadoOrden.Calculada:
                                        <span class="badge bg-info text-dark px-2 py-1">Calculada</span>
                                        break;
                                    case EstadoOrden.Cerrada:
                                        <span class="badge bg-success px-2 py-1">Cerrada</span>
                                        break;
                                    case EstadoOrden.Cancelada:
                                        <span class="badge bg-secondary px-2 py-1">Cancelada</span>
                                        break;
                                }
                            </td>
                            <td class="p-3 text-end">
                                <div class="font-weight-bold">FOB: @item.FobTotal.ToString("N2")</div>
                                @if (item.EstadoOrden == EstadoOrden.Calculada || item.EstadoOrden == EstadoOrden.Cerrada)
                                {
                                    <div class="small text-success">Landed: @item.TotalEstimadoLandedCost.ToString("N2")</div>
                                }
                            </td>
                            <td class="p-3 text-end" style="min-width: 200px;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">Detalle</a>
                                @if (item.EstadoOrden == EstadoOrden.Abierta || item.EstadoOrden == EstadoOrden.Calculada)
                                {
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white me-1">Editar</a>
                                }
                                @if (item.EstadoOrden == EstadoOrden.Abierta)
                                {
                                    <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
